# 复制为 .env 后填写真实值；.env 已在 .gitignore 中，绝不要提交

# ---- 运行时 ----
APP_NAME=cosmetic-agent
ENV=dev
LOG_LEVEL=INFO
CORS_ORIGINS_RAW=http://localhost:5173,http://127.0.0.1:5173

# ---- 对话模型（extractive = 离线抽取式，无需密钥；openai_compatible = 接真实模型）----
LLM_PROVIDER=extractive
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=30
LLM_MAX_TOKENS=800

# ---- 向量模型（切换 embed 模型后必须重新入库）----
EMBED_PROVIDER=mock
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-v3
EMBED_DIM=1024
EMBED_BATCH=16

# ---- 存储（memory = 本地索引文件；pg = pgvector）----
VECTOR_STORE=memory
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cosmetic
INDEX_FILE=data/index/chunks.jsonl
KNOWLEDGE_DIR=data/knowledge
GLOSSARY_FILE=data/knowledge/glossary/ingredients.yaml
COMPLIANCE_FILE=data/compliance/banned_claims.yaml

# ---- 检索策略 ----
RETRIEVAL_POOL=20
RETRIEVAL_TOP_K=5
MIN_ANSWER_SCORE=0.30
RRF_K=60

# ---- Agent 模式（默认关闭；开启后必须同时设 LLM_PROVIDER=openai_compatible）----
AGENT_ENABLED=false
AGENT_MAX_STEPS=6
AGENT_TOOL_TIMEOUT_S=10
